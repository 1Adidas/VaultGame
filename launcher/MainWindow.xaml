<Window x:Class="GameVault.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameVault Client"
        Height="780" Width="1220"
        MinHeight="660" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}">

    <!-- Root Outer Shell with Cyber Obsidian Glass Border -->
    <Border CornerRadius="14" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" /> <!-- Custom Window Title Bar -->
                <RowDefinition Height="*" />  <!-- Main Content Stage -->
            </Grid.RowDefinitions>

            <!-- ==================== 0. CUSTOM HIGH-TECH WINDOW TITLEBAR ==================== -->
            <Border Grid.Row="0" Background="{StaticResource BgHeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Logo & Cyber Vault Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource PrimaryGradient}" Margin="0,0,8,0">
                            <TextBlock Text="🎮" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="GAMEVAULT" FontSize="13" FontWeight="Black" Foreground="White" VerticalAlignment="Center" />
                        <Border Background="#0E192B" BorderBrush="#1A3152" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="CLIENT OS v2.0" FontSize="9" FontWeight="Bold" Foreground="#00E5FF" />
                        </Border>
                    </StackPanel>

                    <!-- Center: Draggable Spacer -->
                    <Grid Grid.Column="1" Background="Transparent" />

                    <!-- Right: Window Chrome Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowCtrlBtn}" Content="─" Click="BtnMinimize_Click" ToolTip="Thu nhỏ" />
                        <Button Style="{StaticResource WindowCtrlBtn}" Content="□" Click="BtnMaximize_Click" ToolTip="Phóng to" Margin="2,0" />
                        <Button Style="{StaticResource WindowCloseBtn}" Content="✕" Click="BtnClose_Click" ToolTip="Đóng ứng dụng" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 1. MÀN HÌNH ĐĂNG NHẬP (CYBER LOGIN CARD) ==================== -->
            <Grid Grid.Row="1" x:Name="viewLogin" Visibility="Visible">
                <!-- Subtle Gradient Glow behind card -->
                <Rectangle Width="700" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#1A6366F1" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#0B0F19" CornerRadius="16" Padding="38"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5">
                    <StackPanel>
                        <!-- Icon Shield Badge -->
                        <Border Width="64" Height="64" CornerRadius="20" Background="{StaticResource PrimaryGradient}" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="🎮" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="GAMEVAULT" FontSize="26" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,24" />

                        <!-- Email Input -->
                        <TextBlock Text="Email tài khoản" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="txtLoginEmail" Margin="0,0,0,16" Padding="14,10" />

                        <!-- Password Input -->
                        <TextBlock Text="Mật khẩu" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <PasswordBox x:Name="txtLoginPassword" Margin="0,0,0,18" Padding="14,10" KeyDown="TxtLoginPassword_KeyDown" />

                        <!-- Hidden Internal Config -->
                        <TextBox x:Name="txtApiUrl" Visibility="Collapsed" />

                        <!-- Error Alert -->
                        <Border x:Name="pnlLoginError" Visibility="Collapsed" Background="#2A0E14" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <TextBlock x:Name="txtLoginError" Text="Lỗi đăng nhập" Foreground="#FDA4AF" FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <!-- Login Button -->
                        <Button x:Name="btnLogin" Style="{StaticResource PrimaryBtn}" Content="ĐĂNG NHẬP VÀO LAUNCHER" Height="46" FontSize="13" FontWeight="Black" Click="BtnLogin_Click" Margin="0,0,0,12" />

                        <!-- Web Register Link -->
                        <Button Style="{StaticResource OutlineBtn}" Content="Chưa có tài khoản? Đăng ký trên Website GameVault" Click="BtnOpenRegisterWeb_Click" Height="40" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== 2. GIAO DIỆN CHÍNH (CYBER DASHBOARD) ==================== -->
            <Grid Grid.Row="1" x:Name="viewMainSteam" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" /> <!-- Top Header Navigation Bar -->
                    <RowDefinition Height="*" />  <!-- Main Body: Sidebar + Shelf Grid -->
                    <RowDefinition Height="30" /> <!-- Modern Status Footer -->
                </Grid.RowDefinitions>

                <!-- TOP NAVIGATION BAR -->
                <Border Grid.Row="0" Background="{StaticResource BgHeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Nav Tabs -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- STORE TAB (Web Store Link) -->
                            <Button x:Name="btnSteamStore" Style="{StaticResource SteamStoreNavBtn}" Click="BtnVisitWebsite_Click" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌐 " FontSize="12" />
                                    <TextBlock Text="CỬA HÀNG (STORE)" FontWeight="Black" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <!-- LIBRARY TAB (Active) -->
                            <Button Style="{StaticResource SteamActiveNavBtn}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎮 " FontSize="12" />
                                    <TextBlock Text="THƯ VIỆN CỦA TÔI" FontWeight="Black" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Center: Omni-Search Bar in Header (Slim & Wide) -->
                        <Border Grid.Column="1" HorizontalAlignment="Center" Width="320" Height="28" Background="#0C101A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,0" VerticalAlignment="Center">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" x:Name="txtSearchGame" Background="Transparent" BorderThickness="0" Padding="4,0" FontSize="12" VerticalAlignment="Center" TextChanged="TxtSearchGame_TextChanged" CaretBrush="#00E5FF" />
                            </Grid>
                        </Border>

                        <!-- Right: User Profile & Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- User Avatar (Bo tron 100% ca anh va vien) -->
                            <Grid Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center">
                                <!-- Base Circle with Initial Fallback -->
                                <Ellipse Fill="{StaticResource PrimaryGradient}" Width="34" Height="34" />
                                <TextBlock x:Name="txtUserAvatarInitial" Text="U" FontWeight="Black" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <!-- Circular Image (Strict 17px radius clip) -->
                                <Image x:Name="imgUserAvatar" Width="34" Height="34" Stretch="UniformToFill" Visibility="Collapsed">
                                    <Image.Clip>
                                        <EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" />
                                    </Image.Clip>
                                </Image>

                                <!-- Neon Cyan Ring Overlay -->
                                <Ellipse Width="34" Height="34" Stroke="#00E5FF" StrokeThickness="1.5" IsHitTestVisible="False" />
                            </Grid>

                            <!-- User Info -->
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="txtUserName" Text="Gamer" FontWeight="Bold" FontSize="13" Foreground="White" />
                                <TextBlock Text="Bản quyền chính hãng" FontSize="10" Foreground="#34D399" FontWeight="Medium" />
                            </StackPanel>

                            <!-- Logout Button -->
                            <Button Style="{StaticResource OutlineBtn}" Padding="10,6" Click="BtnLogout_Click" ToolTip="Đăng xuất khỏi thiết bị này">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🚪 " FontSize="11" />
                                    <TextBlock Text="Đăng xuất" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MAIN BODY AREA (Sidebar Left + Right Shelf Grid) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ==================== CỘT TRÁI (SIDEBAR GAME LIST) ==================== -->
                    <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <Grid Margin="14,14,10,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Sidebar Header -->
                            <Grid Grid.Row="0" Margin="4,0,4,12">
                                <TextBlock Text="BỘ SƯU TẬP" FontSize="12" FontWeight="Black" Foreground="#94A3B8" VerticalAlignment="Center" />
                                <Border Background="#141E30" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="txtGamesCountBadge" Text="0 game" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                                </Border>
                            </Grid>

                            <!-- Filter Pills -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource FilterPillBtn}" Content="Tất cả" Click="BtnFilterAll_Click" Margin="0,0,4,0" />
                                <Button Grid.Column="1" Style="{StaticResource FilterPillBtn}" Content="Đã cài" Click="BtnFilterInstalled_Click" Margin="2,0" />
                                <Button Grid.Column="2" Style="{StaticResource FilterPillBtn}" Content="Chưa tải" Click="BtnFilterNotInstalled_Click" Margin="4,0,0,0" />
                            </Grid>

                            <!-- Compact ListBox -->
                            <ListBox Grid.Row="2" x:Name="lstSidebarGames" Background="Transparent" BorderThickness="0" SelectionChanged="LstGames_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="8,7">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#131B2A" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#19243A" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Status Icon Circle -->
                                            <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#0C121D" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusBadgeIcon}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusColorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <!-- Game Title -->
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusColorBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- ==================== VÙNG CHÍNH (SHELF POSTERS GRID) ==================== -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource BgDarkBrush}" Padding="24">
                        <StackPanel>

                            <!-- Shelf Section Header -->
                            <Grid Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="4" Height="20" Background="{StaticResource PrimaryGradient}" CornerRadius="2" Margin="0,0,10,0" />
                                    <TextBlock Text="KHO TRÒ CHƠI BẢN QUYỀN" FontSize="18" FontWeight="Black" Foreground="White" />
                                    <TextBlock x:Name="txtShelfCount" Text=" (Đang đồng bộ...)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,2,0,0" />
                                </StackPanel>
                                <Button Style="{StaticResource OutlineBtn}" Content="🔄" ToolTip="Làm mới thư viện" Click="BtnRefreshLibrary_Click" HorizontalAlignment="Right" Padding="8,4" Width="36" Height="34" FontSize="13" />
                            </Grid>

                            <!-- Empty State Card -->
                            <Border x:Name="pnlEmptyLibrary" Visibility="Collapsed" Background="{StaticResource BgCardBrush}" CornerRadius="14" Padding="40" Margin="0,20,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="60" Height="60" CornerRadius="18" Background="#162238" HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <TextBlock Text="🎮" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Thư viện của bạn đang trống" FontSize="18" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                                    <TextBlock Text="Ghé thăm Cửa hàng Web (STORE) để kích hoạt game bản quyền vào tài khoản!" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,20" HorizontalAlignment="Center" />
                                    <Button Style="{StaticResource SteamStoreNavBtn}" Content="🌐 Ghé thăm Website Cửa Hàng Ngay" Click="BtnVisitWebsite_Click" HorizontalAlignment="Center" Padding="20,10" />
                                </StackPanel>
                            </Border>

                            <!-- GAME POSTER CARDS GRID -->
                            <ItemsControl x:Name="icGamePosters">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- High-tech Card (210 x 330) -->
                                        <Border Width="210" Height="330" Background="{StaticResource BgCardBrush}" CornerRadius="12" Margin="0,0,18,22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.3" Color="#000000" />
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="240" /> <!-- Poster Art Image -->
                                                    <RowDefinition Height="*" />   <!-- Action Footer -->
                                                </Grid.RowDefinitions>

                                                <!-- 1. Game Poster Art Cover -->
                                                <Border Grid.Row="0" Background="#101522">
                                                    <Grid>
                                                        <!-- Cover Image -->
                                                        <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />

                                                        <!-- Dark Vignette Gradient at Bottom -->
                                                        <Rectangle VerticalAlignment="Bottom" Height="80">
                                                            <Rectangle.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="Transparent" Offset="0" />
                                                                    <GradientStop Color="#F0090D17" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Rectangle.Fill>
                                                        </Rectangle>

                                                        <!-- Top Status Pill Badge -->
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" CornerRadius="8" Padding="7,3" Background="#CC090D17" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="Black" Foreground="{Binding StatusColorBrush}" />
                                                        </Border>

                                                        <!-- Bottom Title Overlay -->
                                                        <Border VerticalAlignment="Bottom" Padding="10,8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="Black" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Version, StringFormat='Phiên bản: v{0}'}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- 2. Bottom Action Footer -->
                                                <Border Grid.Row="1" Background="#0A0E18" Padding="10,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                                    <Grid>
                                                        <!-- A. State: INSTALLED (PLAY NOW) -->
                                                        <Grid Visibility="{Binding IsInstalledVisible}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Emerald Play Button -->
                                                            <Button Grid.Column="0" Tag="{Binding}" Click="BtnCardPlay_Click" Style="{StaticResource PlayBtn}" Height="38" ToolTip="Khởi chạy qua Launcher DRM">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock Text="▶ " FontSize="13" />
                                                                    <TextBlock Text="CHƠI NGAY" FontSize="12" FontWeight="Black" />
                                                                </StackPanel>
                                                            </Button>
                                                            <!-- Options Menu -->
                                                            <Button Grid.Column="1" Tag="{Binding}" Click="BtnCardOptions_Click" Style="{StaticResource OutlineBtn}" Padding="8,4" Height="38" Width="34" Margin="6,0,0,0" Content="⋮" FontSize="14" FontWeight="Bold" ToolTip="Tùy chọn: Mở thư mục / Gỡ cài đặt" />
                                                        </Grid>

                                                        <!-- B. State: NOT INSTALLED (DOWNLOAD) -->
                                                        <Grid Visibility="{Binding IsNotInstalledVisible}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Cyan Download Button -->
                                                            <Button Grid.Column="0" Tag="{Binding}" Click="BtnCardInstall_Click" Style="{StaticResource PrimaryBtn}" Height="38" ToolTip="Tải và cài đặt game">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock Text="⬇ " FontSize="13" />
                                                                    <TextBlock Text="CÀI ĐẶT" FontSize="12" FontWeight="Black" />
                                                                </StackPanel>
                                                            </Button>
                                                            <!-- Options Menu -->
                                                            <Button Grid.Column="1" Tag="{Binding}" Click="BtnCardOptions_Click" Style="{StaticResource OutlineBtn}" Padding="8,4" Height="38" Width="34" Margin="6,0,0,0" Content="⋮" FontSize="14" FontWeight="Bold" ToolTip="Tùy chọn" />
                                                        </Grid>

                                                        <!-- C. State: DOWNLOADING (NEON PROGRESS) -->
                                                        <Grid Visibility="{Binding IsDownloadingVisible}">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <Grid Margin="0,0,0,4">
                                                                    <TextBlock Text="ĐANG TẢI XUỐNG..." FontSize="9" FontWeight="Black" Foreground="#00E5FF" />
                                                                    <TextBlock Text="{Binding DownloadProgressText}" FontSize="10" FontWeight="Black" Foreground="White" HorizontalAlignment="Right" />
                                                                </Grid>
                                                                <ProgressBar Value="{Binding DownloadPercent}" Height="6" Background="#141C2C" Foreground="{StaticResource PrimaryBrush}" BorderThickness="0" />
                                                            </StackPanel>
                                                        </Grid>

                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== 3. FOOTER STATUS BAR ==================== -->
                <Border Grid.Row="2" Background="#06080E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,0">
                    <Grid>
                        <TextBlock Text="🛡️ GameVault DRM Engine Active: Bản quyền game được mã hóa và xác thực trực tiếp" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
