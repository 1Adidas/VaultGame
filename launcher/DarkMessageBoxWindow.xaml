<Window x:Class="GameVault.Launcher.DarkMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameVault"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Inter, sans-serif">
    <Border Background="#161922"
            BorderBrush="#384358"
            BorderThickness="1"
            CornerRadius="10"
            MinWidth="380"
            MaxWidth="460"
            Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Opacity="0.65" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1B202B" CornerRadius="9,9,0,0" Padding="16,12" BorderBrush="#252A38" BorderThickness="0,0,0,1" MouseDown="Header_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtHeaderIcon" Text="🎮" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="txtTitle" Text="Thông báo" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Click="BtnClose_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontWeight="Bold" FontSize="14" Cursor="Hand" Padding="4">
                        <TextBlock Text="✕" FontSize="12" />
                    </Button>
                </Grid>
            </Border>

            <!-- Body Area -->
            <Grid Grid.Row="1" Margin="20,18,20,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="pnlIcon" Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#1E293B" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock x:Name="txtIcon" Text="ℹ" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="txtMessage" Grid.Column="1" Text="Message" FontSize="13" Foreground="#E2E8F0" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Center" />
            </Grid>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" Background="#12141A" CornerRadius="0,0,9,9" Padding="16,12" BorderBrush="#252A38" BorderThickness="0,1,0,0">
                <StackPanel x:Name="pnlButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnCancel" Click="BtnCancel_Click" Content="Hủy" Style="{StaticResource OutlineBtn}" Padding="16,6" Margin="0,0,10,0" MinWidth="75" />
                    <Button x:Name="btnOk" Click="BtnOk_Click" Content="Đồng ý" Style="{StaticResource PrimaryBtn}" Padding="16,6" MinWidth="75" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
