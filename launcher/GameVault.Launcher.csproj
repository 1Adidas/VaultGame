<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CETCompat>false</CETCompat>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SampleGame\**" />
    <EmbeddedResource Remove="SampleGame\**" />
    <None Remove="SampleGame\**" />
    <Page Remove="SampleGame\**" />
    <Compile Remove="Resources\GameVault_DRM\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\GameVault_DRM\GameVaultDrmStub.exe" LogicalName="GameVaultDrmStub.exe" />
  </ItemGroup>

</Project>
